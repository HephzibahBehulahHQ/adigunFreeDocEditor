{
  "name": "adigun-free-doc-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "build:editor": "esbuild src/live-editor-runtime.js --bundle --format=iife --global-name=AdigunEditorBundle --target=es2022 --outfile=editor-runtime.js",
    "build:pdf": "node scripts/prepare_pdf_lib.mjs",
    "build:ocr": "node scripts/prepare_ocr.mjs",
    "start:ai": "node scripts/ai-relay.mjs",
    "test:editor-schema": "node tests/editor-schema.test.mjs",
    "test:editor-html": "node tests/editor-html.test.mjs",
    "test:live-editor": "node tests/live-editor.test.mjs",
    "test:app-live-editor": "node tests/app-live-editor.test.mjs"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list-item": "3.31.3",
    "@tiptap/extension-ordered-list": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "pdf-lib": "1.17.1",
    "tesseract.js": "7.0.0"
  }
}
